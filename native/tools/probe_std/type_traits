// Probe-only stand-in for <type_traits>, used by native/tools/convert_data.py when it lays out the game's records.
// The real headers make the NDK's clang 18 crash while parsing them (exit 139), in both libc++ (the NDK's) and the PS2's
// libstdc++ (GCC 15.2). The probe only needs the names include/abi.h uses and the layouts of the game's own records, so
// this covers exactly those. The game's real builds never see this folder.
#pragma once

namespace std
{
template <class T, class U>
struct is_same
{
    static constexpr bool value = false;
};
template <class T>
struct is_same<T, T>
{
    static constexpr bool value = true;
};
template <class T, class U>
inline constexpr bool is_same_v = is_same<T, U>::value;

template <class T>
struct remove_cv
{
    using type = T;
};
template <class T>
struct remove_cv<const T>
{
    using type = T;
};
template <class T>
struct remove_cv<volatile T>
{
    using type = T;
};
template <class T>
struct remove_cv<const volatile T>
{
    using type = T;
};
template <class T>
using remove_cv_t = typename remove_cv<T>::type;

template <class T>
struct is_pointer
{
    static constexpr bool value = false;
};
template <class T>
struct is_pointer<T*>
{
    static constexpr bool value = true;
};
// (no partial specialization derives from another one: clang 18 crashes parsing that, see the probe's notes)
template <class T>
struct is_pointer<T* const>
{
    static constexpr bool value = true;
};
template <class T>
struct is_pointer<T* volatile>
{
    static constexpr bool value = true;
};
template <class T>
struct is_pointer<T* const volatile>
{
    static constexpr bool value = true;
};
template <class T>
inline constexpr bool is_pointer_v = is_pointer<T>::value;

template <class T>
struct is_reference
{
    static constexpr bool value = false;
};
template <class T>
struct is_reference<T&>
{
    static constexpr bool value = true;
};
template <class T>
struct is_reference<T&&>
{
    static constexpr bool value = true;
};
template <class T>
inline constexpr bool is_reference_v = is_reference<T>::value;

template <class T>
struct is_void_base
{
    static constexpr bool value = false;
};
template <>
struct is_void_base<void>
{
    static constexpr bool value = true;
};
template <class T>
struct is_void
{
    static constexpr bool value = is_void_base<remove_cv_t<T>>::value;
};
template <class T>
inline constexpr bool is_void_v = is_void<T>::value;

template <class T>
struct is_enum
{
    static constexpr bool value = __is_enum(T);
};
template <class T>
inline constexpr bool is_enum_v = is_enum<T>::value;

// The integer types, by their own names (the probe's types are the game's: no char8_t, no 128-bit integers)
template <class T>
struct is_integral_base
{
    static constexpr bool value = false;
};
#define TWIN_PROBE_INTEGRAL(T) \
    template <> \
    struct is_integral_base<T> \
    { \
        static constexpr bool value = true; \
    };
TWIN_PROBE_INTEGRAL(bool)
TWIN_PROBE_INTEGRAL(char)
TWIN_PROBE_INTEGRAL(signed char)
TWIN_PROBE_INTEGRAL(unsigned char)
TWIN_PROBE_INTEGRAL(wchar_t)
TWIN_PROBE_INTEGRAL(char16_t)
TWIN_PROBE_INTEGRAL(char32_t)
TWIN_PROBE_INTEGRAL(short)
TWIN_PROBE_INTEGRAL(unsigned short)
TWIN_PROBE_INTEGRAL(int)
TWIN_PROBE_INTEGRAL(unsigned int)
TWIN_PROBE_INTEGRAL(long)
TWIN_PROBE_INTEGRAL(unsigned long)
TWIN_PROBE_INTEGRAL(long long)
TWIN_PROBE_INTEGRAL(unsigned long long)
#undef TWIN_PROBE_INTEGRAL
template <class T>
struct is_integral
{
    static constexpr bool value = is_integral_base<remove_cv_t<T>>::value;
};
template <class T>
inline constexpr bool is_integral_v = is_integral<T>::value;
} // namespace std
